# default recipe
default:
    @just --list

# Build all C++ targets in Debug mode
build-cpp:
    @echo "Configuring C++ targets..."
    cmake -S cpp -B cpp/build -DCMAKE_BUILD_TYPE=Debug
    @echo "Building C++ targets..."
    cd cpp/build && make

# Clean the C++ build directory
clean-cpp:
    @echo "Cleaning C++ build artifacts..."
    rm -rf cpp/build

# Clean and re-build C++ targets
rebuild-cpp: clean-cpp build-cpp

build-rust:
    cd ./rust && cargo build

# Create venv and install packages for python-venv targets
setup-python-venv:
    python3 -m venv python-venv/venv
    python-venv/venv/bin/pip install -r python-venv/requirements.txt

# Remove the python-venv virtualenv
clean-python-venv:
    rm -rf python-venv/venv
